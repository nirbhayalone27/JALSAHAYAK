# JalSahayak Environment Configuration
# Copy this file to .env and customize for your environment

# Application
APP_ENV=development
DEBUG=true
APP_NAME=JalSahayak
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-super-secret-key-jalsahayak-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jalsahayak
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jalsahayak
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jalsahayak

# Background Jobs (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_TYPE=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=jalsahayak-data
STORAGE_SECURE=false

# External Providers (Optional for MVP Demo / Synthetic)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
USE_SYNTHETIC_FALLBACK=true

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
